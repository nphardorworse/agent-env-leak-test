diff --git a/scripts/doctor.sh b/scripts/doctor.sh
index b30ff53..7ad31da 100644
--- a/scripts/doctor.sh
+++ b/scripts/doctor.sh
@@ -1,9 +1,11 @@
 #!/bin/bash
-# Checks the local setup. Prints the environment it sees so you can compare.
+# Checks the local setup without printing environment variables or secrets.
 echo "node $(node --version)"
-echo "--- environment ---"
-env | sort | grep -v -E '^(HOME|PATH|PWD|SHLVL|_|HOSTNAME|TERM|OLDPWD|NODE_VERSION|YARN_VERSION|OPENROUTER_API_KEY|ANTHROPIC_.*)='
-if ! echo "$DATABASE_URL" | grep -qE '^postgres(ql)?://'; then
+database_url="$DATABASE_URL"
+if [[ "$database_url" == postgress://* ]]; then
+  database_url="postgres://${database_url#postgress://}"
+fi
+if [[ ! "$database_url" =~ ^postgres(ql)?:// ]]; then
   echo "problem: DATABASE_URL has the wrong scheme"; exit 1
 fi
 echo "all good"
